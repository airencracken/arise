{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/airencracken/arise/blob/master/docs/schemas/profile-v1.schema.json",
  "title": "Arise profile inspection report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "active_path", "layers", "defaults", "policies", "unsupported_files"],
  "properties": {
    "schema": { "const": "arise.profile.v1" },
    "scope": { "const": "profile" },
    "active_path": { "type": "string", "minLength": 1 },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "parent_references"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "parent_references": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "defaults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "contributions"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "string" },
          "contributions": { "$ref": "#/$defs/contributions" }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "values", "contributions"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["effective", "ordered_rules"] },
          "values": { "$ref": "#/$defs/strings" },
          "contributions": { "$ref": "#/$defs/contributions" }
        }
      }
    },
    "unsupported_files": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string" } },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "source"],
        "properties": {
          "value": { "type": "string" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "line"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "line": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
