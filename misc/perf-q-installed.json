{
  "name": "native-installed-package-listing",
  "warmups": 2,
  "runs": 15,
  "cases": [
    {
      "name": "all-installed-cpvs",
      "report_only": true,
      "normalize": "sorted-lines",
      "arise": {
        "tool": "arise",
        "path": "./arise",
        "args": ["installed", "--versions"],
        "version_args": ["--version"]
      },
      "reference": {
        "tool": "qlist",
        "path": "qlist",
        "args": ["-IvC"],
        "version_args": ["--version"]
      }
    },
    {
      "name": "all-installed-versionless-cps",
      "report_only": true,
      "normalize": "sorted-lines",
      "arise": {
        "tool": "arise",
        "path": "./arise",
        "args": ["installed"],
        "version_args": ["--version"]
      },
      "reference": {
        "tool": "qlist",
        "path": "qlist",
        "args": ["-IC"],
        "version_args": ["--version"]
      }
    }
  ]
}
